/*
 * Corne 3x6 keymap — starting point. Edit everything else in ZMK Studio.
 * Hold LOWER: numbers, arrows, Bluetooth.  Hold RAISE: symbols, system keys.
 * STUDIO = unlock key for the web editor (RAISE layer, left pinky top).
 * OFF    = hold RAISE + C for 2 sec to power off. Press RESET on each half to turn on.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// OFF key must be held 2 seconds so you can't hit it by accident
&soft_off {
    hold-time-ms = <2000>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&kp TAB   &kp Q &kp W &kp E &kp R &kp T     &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
&kp LCTRL &kp A &kp S &kp D &kp F &kp G     &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT &kp Z &kp X &kp C &kp V &kp B     &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &kp LGUI &mo 1 &kp SPACE     &kp RET &mo 2 &kp RALT
            >;
        };

        lower {
            display-name = "Lower";
            bindings = <
&kp TAB   &kp N1       &kp N2       &kp N3       &kp N4       &kp N5          &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
&kp LCTRL &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
&kp LSHFT &bt BT_CLR   &trans       &trans       &trans       &trans          &kp HOME &kp PG_DN &kp PG_UP &kp END &trans &trans
                  &kp LGUI &trans &kp SPACE     &kp RET &trans &kp RALT
            >;
        };

        raise {
            display-name = "Raise";
            bindings = <
&studio_unlock &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT     &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
&kp LCTRL &out OUT_TOG &out OUT_USB &out OUT_BLE &trans &trans     &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
&kp LSHFT &bootloader  &sys_reset   &soft_off    &trans &trans     &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                  &kp LGUI &trans &kp SPACE     &kp RET &trans &kp RALT
            >;
        };

        // Empty slots you can turn into new layers (e.g. a gaming layer) from Studio
        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
        extra3 { status = "reserved"; };
    };
};
